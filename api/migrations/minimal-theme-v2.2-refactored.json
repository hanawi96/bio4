{
  "meta": {
    "id": "preset.ttttttttt",
    "name": "ttttttttt",
    "schemaVersion": 2,
    "version": "2.2.0",
    "author": "system",
    "description": "",
    "tier": "free",
    "category": "minimal",
    "contract": {
      "controls": [
        {
          "keyPath": "page.layout.textAlign",
          "type": "select",
          "options": [
            "left",
            "center",
            "right"
          ],
          "label": "Text Alignment",
          "default": "center"
        },
        {
          "keyPath": "page.layout.baseFontSize",
          "type": "select",
          "options": [
            "S",
            "M",
            "L",
            "XL"
          ],
          "label": "Font Size",
          "default": "M",
          "map": {
            "S": "ref:tokens.typography.fontSize.sm",
            "M": "ref:tokens.typography.fontSize.base",
            "L": "ref:tokens.typography.fontSize.lg",
            "XL": "ref:tokens.typography.fontSize.xl"
          }
        },
        {
          "keyPath": "page.layout.pagePadding",
          "type": "slider",
          "min": 8,
          "max": 32,
          "step": 4,
          "label": "Page Padding",
          "default": 16,
          "unit": "px"
        },
        {
          "keyPath": "page.layout.blockGap",
          "type": "slider",
          "min": 8,
          "max": 32,
          "step": 2,
          "label": "Block Spacing",
          "default": 14,
          "unit": "px"
        },
        {
          "keyPath": "background.effects.blur",
          "type": "slider",
          "min": 0,
          "max": 12,
          "step": 1,
          "label": "Background Blur",
          "default": 0,
          "unit": "px"
        },
        {
          "keyPath": "background.effects.dim",
          "type": "slider",
          "min": 0,
          "max": 0.8,
          "step": 0.05,
          "label": "Background Dim",
          "default": 0
        }
      ]
    }
  },
  "tokens": {
    "meta": {
      "spaceUnit": "px",
      "fontSizeUnit": "px"
    },
    "color": {
      "gray": {
        "50": "#fafafa",
        "100": "#f4f4f5",
        "200": "#e4e4e7",
        "300": "#d4d4d8",
        "400": "#a1a1aa",
        "500": "#71717a",
        "600": "#52525b",
        "700": "#3f3f46",
        "800": "#27272a",
        "900": "#18181b"
      },
      "blue": {
        "50": "#eff6ff",
        "100": "#dbeafe",
        "400": "#60a5fa",
        "500": "#3b82f6",
        "600": "#2563eb",
        "700": "#1d4ed8"
      },
      "white": "#ffffff",
      "black": "#000000",
      "overlay": {
        "10": "rgba(0, 0, 0, 0.1)",
        "20": "rgba(0, 0, 0, 0.2)",
        "50": "rgba(0, 0, 0, 0.5)",
        "80": "rgba(0, 0, 0, 0.8)"
      },
      "blockText": "#ffffff",
      "shadowColor": "#000000"
    },
    "typography": {
      "fontFamily": {
        "sans": "Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif"
      }
    }
  },
  "semantic": {
    "color": {
      "primary": "#3b82f6",
      "primaryHover": "ref:tokens.color.blue.600",
      "secondary": "ref:tokens.color.gray.500",
      "text": {
        "default": "#ffffff",
        "muted": "#ffffff",
        "subtle": "ref:tokens.color.gray.400",
        "invert": "ref:tokens.color.white"
      },
      "surface": {
        "page": "radial-gradient(circle farthest-corner at center, #22543d 0%, #38a169 50%, #ecc94b 100%)",
        "card": "ref:tokens.color.white",
        "elevated": "ref:tokens.color.white",
        "overlay": "ref:tokens.color.overlay.50"
      },
      "border": {
        "default": "#e4e4e7",
        "subtle": "ref:tokens.color.gray.100",
        "strong": "ref:tokens.color.gray.300"
      },
      "block": {
        "text": "ref:tokens.color.blockText"
      }
    },
    "typography": {
      "heading": {
        "fontFamily": "ref:tokens.typography.fontFamily.sans",
        "fontSize": "ref:tokens.typography.fontSize.2xl",
        "fontWeight": "ref:tokens.typography.fontWeight.bold",
        "lineHeight": "ref:tokens.typography.lineHeight.tight"
      },
      "body": {
        "fontFamily": "ref:tokens.typography.fontFamily.sans",
        "fontSize": "ref:tokens.typography.fontSize.base",
        "fontWeight": "ref:tokens.typography.fontWeight.normal",
        "lineHeight": "ref:tokens.typography.lineHeight.normal"
      },
      "caption": {
        "fontFamily": "ref:tokens.typography.fontFamily.sans",
        "fontSize": "ref:tokens.typography.fontSize.sm",
        "fontWeight": "ref:tokens.typography.fontWeight.normal",
        "lineHeight": "ref:tokens.typography.lineHeight.normal"
      }
    }
  },
  "page": {
    "layout": {
      "maxWidth": 480,
      "pagePadding": 16,
      "blockGap": 14,
      "textAlign": "left",
      "baseFontSize": "M",
      "blockPadding": {
        "x": 16,
        "y": 12
      }
    },
    "defaults": {
      "headerPresetId": "no-cover",
      "blockStylePreset": "outline",
      "borderWidth": 1,
      "linkStyle": "soft",
      "linkGroupLayout": "grid",
      "linkIconShape": "rounded",
      "socialIconPosition": "header",
      "avatarBorderColor": "#ffffff",
      "avatarBorderWidth": 4,
      "shadowStyle": "none",
      "blockOpacity": 100,
      "linkGroupConfig": {
        "list": {
          "iconPosition": "left",
          "textAlign": "center"
        },
        "grid": {
          "columns": 2,
          "aspectRatio": "square",
          "showLabels": true,
          "imagePadding": false
        },
        "cards": {
          "imagePosition": "left",
          "imageSize": 50,
          "imageAspect": "square",
          "showSubtitle": true,
          "imagePadding": false
        }
      }
    }
  },
  "background": {
    "wallpaper": {
      "kind": "preset",
      "assetId": null,
      "url": null
    },
    "effects": {
      "blur": 0,
      "dim": 0,
      "overlayColor": "ref:tokens.color.overlay.10",
      "brightness": 100,
      "grayscale": 0
    }
  },
  "recipes": {
    "link": {
      "base": {
        "radius": "ref:tokens.radius.md"
      }
    }
  }
}