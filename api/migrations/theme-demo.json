{
  "meta": {
    "id": "preset.theme-1",
    "name": "Theme 1",
    "schemaVersion": 2,
    "version": "2.2.0",
    "author": "system",
    "description": "",
    "tier": "free",
    "category": "minimal",
    "contract": {
      "controls": [
        {
          "keyPath": "page.layout.textAlign",
          "type": "select",
          "label": "Text Alignment",
          "options": [
            "left",
            "center",
            "right"
          ],
          "default": "center"
        },
        {
          "keyPath": "page.layout.pagePadding",
          "type": "slider",
          "label": "Page Padding",
          "min": 8,
          "max": 32,
          "step": 4,
          "default": 16,
          "unit": "px"
        },
        {
          "keyPath": "page.layout.blockGap",
          "type": "slider",
          "label": "Block Spacing",
          "min": 8,
          "max": 32,
          "step": 2,
          "default": "default",
          "unit": "px"
        }
      ]
    }
  },
  "tokens": {
    "meta": {
      "spaceUnit": "px",
      "fontSizeUnit": "px"
    },
    "color": {
      "gray": {
        "50": "#fafafa",
        "100": "#f4f4f5",
        "200": "#e4e4e7",
        "300": "#d4d4d8",
        "400": "#a1a1aa",
        "500": "#71717a",
        "600": "#52525b",
        "700": "#3f3f46",
        "800": "#27272a",
        "900": "#18181b"
      },
      "blue": {
        "50": "#eff6ff",
        "100": "#dbeafe",
        "400": "#60a5fa",
        "500": "#3b82f6",
        "600": "#2563eb",
        "700": "#1d4ed8"
      },
      "white": "#ffffff",
      "black": "#000000",
      "overlay": {
        "10": "rgba(0, 0, 0, 0.1)",
        "20": "rgba(0, 0, 0, 0.2)",
        "50": "rgba(0, 0, 0, 0.5)",
        "80": "rgba(0, 0, 0, 0.8)"
      },
      "blockText": "#ffffff",
      "shadowColor": "#000000"
    },
    "typography": {
      "fontFamily": {
        "sans": "Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif"
      },
      "fontSize": {
        "xs": 12,
        "sm": 14,
        "base": 16,
        "lg": 18,
        "xl": 20,
        "2xl": 24
      },
      "fontWeight": {
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      },
      "lineHeight": {
        "tight": 1.25,
        "normal": 1.5,
        "relaxed": 1.75
      }
    }
  },
  "semantic": {
    "color": {
      "primary": "#3b82f6",
      "primaryHover": "ref:tokens.color.blue.600",
      "secondary": "ref:tokens.color.gray.500",
      "text": {
        "default": "#ffffff",
        "muted": "#ffffff",
        "subtle": "ref:tokens.color.gray.400",
        "invert": "ref:tokens.color.white"
      },
      "surface": {
        "page": "#000000",
        "card": "ref:tokens.color.white",
        "elevated": "ref:tokens.color.white",
        "overlay": "ref:tokens.color.overlay.50"
      },
      "border": {
        "default": "#e4e4e7",
        "subtle": "ref:tokens.color.gray.100",
        "strong": "ref:tokens.color.gray.300"
      },
      "block": {
        "text": "ref:tokens.color.blockText"
      }
    },
    "typography": {
      "heading": {
        "fontFamily": "ref:tokens.typography.fontFamily.sans",
        "fontSize": "ref:tokens.typography.fontSize.2xl",
        "fontWeight": "ref:tokens.typography.fontWeight.bold",
        "lineHeight": "ref:tokens.typography.lineHeight.tight"
      },
      "link": {
        "fontSize": "ref:tokens.typography.fontSize.xs"
      },
      "bio": {
        "fontSize": "ref:tokens.typography.fontSize.xs"
      },
      "subtitle": {
        "fontSize": "ref:tokens.typography.fontSize.xs"
      }
    }
  },
  "page": {
    "layout": {
      "maxWidth": 480,
      "pagePadding": 16,
      "blockGap": "default",
      "textAlign": "center",
      "blockPadding": "spacious"
    },
    "defaults": {
      "headerPresetId": "no-cover",
      "blockStylePreset": "glass",
      "linkStyle": "soft",
      "linkGroupLayout": "list",
      "linkIconShape": "rounded",
      "socialIconPosition": "footer",
      "socialIconColor": "#ffffff",
      "gradientPreset": "diagonal-dark",
      "avatarBorderColor": "#ffffff",
      "avatarBorderWidth": 4,
      "shadowStyle": "none",
      "blockOpacity": 100,
      "borderRadius": "lg",
      "borderWidth": "default",
      "linkGroupConfig": {
        "list": {
          "iconPosition": "left",
          "textAlign": "center",
          "showSubtitle": false
        },
        "grid": {
          "columns": 2,
          "aspectRatio": "square",
          "showLabels": true,
          "imagePadding": false
        },
        "cards": {
          "imagePosition": "left",
          "imageSize": 50,
          "imageAspect": "square",
          "showSubtitle": true,
          "imagePadding": false
        }
      }
    }
  },
  "background": {
    "effects": {
      "blur": 0,
      "overlayColor": "ref:tokens.color.overlay.10",
      "brightness": 100,
      "grayscale": 0
    },
    "type": "gradient",
    "value": "linear-gradient(135deg, #6b46c1 0%, #ed64a6 100%)"
  }
}